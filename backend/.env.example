# 修必达 FixIt AI 后端环境变量模板（复制为 backend/.env 并填入你的 key）
# 智谱 GLM：https://open.bigmodel.cn 控制台 → API keys
# 留空 = AI 服务未配置；前端会明确提示失败，用户可主动选择模板演示
FIXITAI_AI_API_KEY=
FIXITAI_AI_TEXT_MODEL=glm-4-flash
FIXITAI_AI_TIMEOUT_SECONDS=60

# 运行边界：dev（本机/比赛演示）或 public（对外公开服务）
# public 模式将关闭 /docs，并要求自行配置 CORS 与调用额度
FIXITAI_DEPLOYMENT_MODE=dev
FIXITAI_EXPOSE_API_DOCS=true

# 账号会话（HttpOnly Cookie，服务端可撤销）
# 生产（public）必须设置随机长密钥；不得使用硬编码默认值。
# 本地 dev 不设置时使用进程内随机密钥（重启后 CSRF 令牌失效）。
FIXITAI_SESSION_SECRET=
FIXITAI_SESSION_TTL_SECONDS=604800
# 本地 HTTP 开发保持 false；生产 public 默认 true，也可显式设置
# FIXITAI_SESSION_COOKIE_SECURE=false
FIXITAI_SESSION_COOKIE_SAMESITE=lax
FIXITAI_AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
FIXITAI_AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=5
FIXITAI_GUEST_AI_RATE_LIMIT_PER_MINUTE=2

# 线上账号与设备需要可持久化的数据库
# 本地开发默认 sqlite:///./fixitai.db；线上请配置托管 PostgreSQL 连接串。
# 不要把真实连接凭据提交到版本库或发送到聊天。
# FIXITAI_DATABASE_URL=postgresql://user:password@host:5432/dbname

# 公开服务时请改为实际前端域名（JSON 数组）
# FIXITAI_CORS_ORIGINS=["https://your-domain.example"]

# 模型接口保护（单实例内存限流；多实例需改用 Redis 等共享存储）
FIXITAI_AI_RATE_LIMIT_PER_MINUTE=8
FIXITAI_AI_MAX_CONCURRENT=2
FIXITAI_AI_MAX_REQUEST_BYTES=16384
