# ============================================================
# 智修AI（FixItAI）环境变量示例
# 复制为 backend/.env 或根目录 .env 后填写
# 注意：密钥只保存在服务端，严禁写入前端代码或提交到 Git
# ============================================================

# ---- 后端基础 ----
# 数据库连接（开发期使用 SQLite）
FIXITAI_DATABASE_URL=sqlite:///./fixitai.db

# ---- AI 服务（DEV-06 接入，当前为占位）----
FIXITAI_AI_TEXT_MODEL=
FIXITAI_AI_VISION_MODEL=
FIXITAI_AI_API_KEY=
